name: cloudpilot
x-logging: &logging
  driver: awslogs
  options:
    awslogs-region: ${region}
    awslogs-group: ${log_group}
    awslogs-create-stream: "true"
    mode: non-blocking
    max-buffer-size: 4m
services:
  backend:
    image: ${backend_image}
    restart: unless-stopped
    init: true
    env_file:
      - path: /run/cloudpilot/backend.env
        format: raw
    environment:
      CLOUDPILOT_EXECUTION_ENABLED: "false"
      CLOUDPILOT_DATABASE_PATH: /data/cloudpilot.sqlite3
      CLOUDPILOT_CORS_ORIGINS: '["https://${domain_name}"]'
      AWS_EC2_METADATA_DISABLED: "true"
    volumes:
      - /srv/cloudpilot/database:/data
    read_only: true
    tmpfs:
      - /tmp:size=64m,mode=1777
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    mem_limit: 2300m
    healthcheck:
      test: [CMD, python, -c, "import urllib.request; urllib.request.urlopen('http://localhost:8001/api/health', timeout=5)"]
      interval: 15s
      timeout: 6s
      start_period: 180s
      retries: 20
    logging:
      <<: *logging
      options:
        awslogs-region: ${region}
        awslogs-group: ${log_group}
        awslogs-stream: backend
        mode: non-blocking
        max-buffer-size: 4m
  frontend:
    image: ${frontend_image}
    restart: unless-stopped
    depends_on:
      backend:
        condition: service_healthy
    mem_limit: 192m
    security_opt: [no-new-privileges:true]
    logging:
      <<: *logging
      options:
        awslogs-region: ${region}
        awslogs-group: ${log_group}
        awslogs-stream: frontend
        mode: non-blocking
        max-buffer-size: 4m
  gateway:
    image: caddy:2.10.2-alpine
    restart: unless-stopped
    depends_on: [frontend]
    env_file:
      - path: /run/cloudpilot/gateway.env
        format: raw
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /opt/cloudpilot/Caddyfile:/etc/caddy/Caddyfile:ro
      - /srv/cloudpilot/caddy-data:/data
      - /srv/cloudpilot/caddy-config:/config
    mem_limit: 192m
    security_opt: [no-new-privileges:true]
    logging:
      <<: *logging
      options:
        awslogs-region: ${region}
        awslogs-group: ${log_group}
        awslogs-stream: gateway
        mode: non-blocking
        max-buffer-size: 4m
