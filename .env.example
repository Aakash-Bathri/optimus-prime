# Optional overrides. Backend defaults work without copying this file.
CLOUDPILOT_CORS_ORIGINS=["http://localhost:5173"]
# Relative paths are resolved from the repository root.
CLOUDPILOT_DATABASE_PATH=data/local/cloudpilot.sqlite3
# Frontend requests use Vite's /api proxy by default.
# VITE_API_BASE_URL=http://localhost:8000

# Delivered historical dataset; relative to repository root.
CLOUDPILOT_DATASET_PATH=test-data

# Person 5 integrations (optional for analysis-only use)
LOCALSTACK_TOKEN =
LOCALSTACK_AUTH_TOKEN=
OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
OPENAI_API_KEY=
CLOUDPILOT_LLM_MODEL=qwen.qwen3-coder-480b-a35b-instruct
CLOUDPILOT_LLM_MAX_TOKENS=1024
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=github_app_private_key/your-app.private-key.pem
GITHUB_INSTALLATION_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CLOUDPILOT_GITHUB_TEST_REPO=Harshavardhan2903/cloudpilot-terraform-demo
CLOUDPILOT_API_PORT=8001
CLOUDPILOT_EXECUTION_TOKEN=
CLOUDPILOT_EVIDENCE_MAX_AGE_SECONDS=3600
VITE_API_BASE_URL=http://127.0.0.1:8001

# Optional Qwen overrides for monitoring explanations (otherwise existing LLM config is used).
# QWEN_API_KEY=
# QWEN_BASE_URL=https://your-openai-compatible-qwen-endpoint/v1
# QWEN_MODEL=qwen.qwen3-coder-480b-a35b-instruct

# Enable only on a loopback-bound local demo; never on a public deployment.
CLOUDPILOT_LOCAL_TOKEN_PREFILL=false
